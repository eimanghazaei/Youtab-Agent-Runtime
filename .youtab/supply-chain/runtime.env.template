# Required in every admitted Youtab runtime image/pod.
YOUTAB_RUNTIME_DOWNLOAD_POLICY=deny
HERMES_DISABLE_LAZY_INSTALLS=1
PIP_NO_INDEX=1
PIP_DISABLE_PIP_VERSION_CHECK=1
UV_OFFLINE=1
npm_config_offline=true
npm_config_audit=false
npm_config_fund=false

# Do not configure HERMES_LAZY_INSTALL_TARGET in production. The Youtab policy
# still wins if it is accidentally present, but admitted images are immutable.
